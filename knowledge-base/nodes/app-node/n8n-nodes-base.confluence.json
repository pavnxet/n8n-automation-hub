    {
      "resource": "Attachment",
      "operation": "Delete",
      "description": "move an attachment to the trash, or permanently delete it",
      "doc": ""
    },
    {
      "resource": "Attachment",
      "operation": "Get Many",
      "description": "list the attachments on a page, optionally downloading each file",
      "doc": ""
    },
    {
      "resource": "Attachment",
      "operation": "Upload",

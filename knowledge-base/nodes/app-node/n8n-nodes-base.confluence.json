      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Add Comment",
      "description": "add a footer comment to a page, or reply to an existing comment",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Add Labels",
      "description": "add one or more labels to a page",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Append",
      "description": "append content to the bottom of an existing page",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Create",
      "description": "create a new page in a space, optionally as a draft, private, at the space root, or under a parent page",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Delete",
      "description": "move a page to trash, or permanently delete it. Child pages aren't deleted. They move up to the deleted page's parent",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Delete Comment",
      "description": "permanently delete a footer comment",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Get",
      "description": "retrieve a page, optionally with its full sub-tree, returning one item per page in tree order, the page itself first",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Get Comments",
      "description": "list the top-level footer comments on a page",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Get Labels",
      "description": "list the labels on a page",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Get Many by Label",
      "description": "retrieve all pages carrying a label, optionally within one space",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Remove Label",
      "description": "remove a label from a page",
      "doc": ""
    },
    {
      "resource": "Page",
      "operation": "Update",
      "description": "replace the title and body of an existing page, or change its draft/published status",
      "doc": ""
    },
    {
      "resource": "Search",
      "operation": "Query",

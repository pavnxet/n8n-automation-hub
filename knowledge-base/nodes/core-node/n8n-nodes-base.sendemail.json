      "name": "Operation",
      "description": "The Send Email node supports the following operations:",
      "options": [
        "Send: Send an email"
      ]
    },
    {
      "name": "From Email",
      "description": "Enter the email address you want to send the email from. You can also include a name using this format: Name Name <email@sample.com>, for example: Nathan Doe <nate@n8n.io>"
    },
    {
      "name": "To Email",
      "description": "Enter the email address you want to send the email to. You can also include a name using this format: Name Name <email@sample.com>, for example: Nathan Doe <nate@n8n.io>. Use a comma to separate multiple email addresses: first@sample.com, \"Name\" <second@sample.com>"
    },
    {
      "name": "Subject",
      "description": "Enter the subject line for the email"
    },
    {
      "name": "Email Format",
      "description": "Select the format to send the email in. This parameter is available when using the Send operation. Choose from:",
      "options": [
        "Text: Send the email in plain-text format",
        "HTML: Send the email in HTML format"
      ]
    },
    {
      "name": "Append n8n Attribution",
      "description": "Set whether to include the phrase This email was sent automatically with n8n at the end of the email (turned on) or not (turned off)"
    },
    {
      "name": "Attachments",
      "description": "Enter the name of the binary properties that contain data to add as an attachment. Some tips on using this option:"
    },
    {
      "name": "CC Email",
      "description": "Enter an email address for the cc: field"
    },
    {
      "name": "BCC Email",
      "description": "Enter an email address for the bcc: field"
    },
    {
      "name": "Ignore SSL Issues",
      "description": "Set whether n8n should ignore failures with TLS/SSL certificate validation (turned on) or enforce them (turned off)"
    },
    {
      "name": "Reply To",
      "description": "Enter an email address for the Reply To field"
    }

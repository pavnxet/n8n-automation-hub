  "operation_count": 0,
  "parameters": [
    {
      "name": "Append",
      "description": "Keep data from all inputs. Choose a Number of Inputs to output items of each input, one after another. The node waits for the execution of all connected inputs"
    },
    {
      "name": "Combine",
      "description": "Combine data from two inputs. Select an option in Combine By to determine how you want to merge the input data"
    },
    {
      "name": "Matching Fields",
      "description": "Compare items by field values. Enter the fields you want to compare in Fields to Match",
      "options": [
        "Keep Matches: Merge items that match. This is like an inner join",
        "Keep Non-Matches: Merge items that don't match"
      ]
    },
    {
      "name": "Position",
      "description": "Combine items based on their order. The item at index 0 in Input 1 merges with the item at index 0 in Input 2, and so on"
    },
    {
      "name": "All Possible Combinations",
      "description": "Output all possible item combinations, while merging fields with the same name"
    },
    {
      "name": "Combine mode options",
      "description": "When merging data by Mode > Combine, you can set these Options:"
    },
    {
      "name": "Clash Handling"
    },
    {
      "name": "SQL Query",
      "description": "Write a custom SQL Query to merge the data"
    },
    {
      "name": "Use query parameters",
      "description": "When creating a SQL query in the Merge node, you can use the Query Parameters field in the Options section to load values into the query. n8n treats query parameter values as data, which helps avoid changing the SQL query structure with dynamic values"
    },
    {
      "name": "Handle queries that return no rows",
      "description": "Use Options > Empty Query Result to choose what the node outputs when the query runs without errors but returns no rows:",
      "options": [
        "Empty Result (default): the node outputs no items",
        "Success: the node outputs a single item, { \"success\": true }"
      ]
    },
    {
      "name": "Choose Branch",
      "description": "Choose which input to keep. This option always waits until the data from both inputs is available. You can choose to Output:",
      "options": [
        "The Input 1 Data",
        "The Input 2 Data",
        "A Single, Empty Item"
      ]
    }
  ],
